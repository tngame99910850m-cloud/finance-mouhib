generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  currency      String    @default("QAR")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  setupComplete Boolean   @default(false)

  incomes             Income[]
  expenses             Expense[]
  budgets              Budget[]
  savingsGoals         SavingsGoal[]
  investments          Investment[]
  vacations             Vacation[]
  recurringExpenses     RecurringExpense[]
  settings              Settings?
  financialRules        FinancialRule[]
  calendarEvents        CalendarEvent[]
}

model Income {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month       String   // "YYYY-MM"
  basicSalary Float    @default(0)
  allowances  Float    @default(0)
  bonuses     Float    @default(0)
  overtime    Float    @default(0)
  otherIncome Float    @default(0)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, month])
  @@index([userId])
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  category    String
  subcategory String?
  date        DateTime
  description String?
  isRecurring Boolean  @default(false)
  paymentMethod String @default("Card")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([userId, category])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String   // "YYYY-MM"
  category  String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, category])
  @@index([userId])
}

model SavingsGoal {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  targetAmount       Float
  currentAmount      Float    @default(0)
  monthlyContribution Float   @default(0)
  targetDate         DateTime?
  icon               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

model Investment {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  category           String   // Cash, Fixed-income/Sukuk, ETFs, Index Funds, Stocks, Gold, Other
  initialAmount      Float    @default(0)
  monthlyContribution Float   @default(0)
  expectedAnnualReturn Float  @default(0) // percent
  durationYears      Float    @default(1)
  feesPercent        Float    @default(0)
  riskProfile        String   @default("Moderate")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  contributions InvestmentContribution[]

  @@index([userId])
}

model InvestmentContribution {
  id           String     @id @default(cuid())
  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  amount       Float
  date         DateTime
  createdAt    DateTime   @default(now())

  @@index([investmentId])
}

model Vacation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination    String
  travelDate     DateTime
  flightCost     Float    @default(0)
  hotelCost      Float    @default(0)
  foodBudget     Float    @default(0)
  transportation Float    @default(0)
  activities     Float    @default(0)
  shopping       Float    @default(0)
  buffer         Float    @default(0)
  savedSoFar     Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model RecurringExpense {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  category      String
  amount        Float
  dayOfMonth    Int      @default(1)
  paymentMethod String   @default("Card")
  active        Boolean  @default(true)
  startMonth    String   // "YYYY-MM"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Settings {
  id                 String  @id @default(cuid())
  userId             String  @unique
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme              String  @default("system")
  displayCurrency    String  @default("QAR")
  needsPercent       Float   @default(50)
  wantsPercent       Float   @default(30)
  savingsPercent     Float   @default(20)
  emergencyTargetMonths Int  @default(6)
  allocEmergencyPct  Float   @default(20)
  allocInvestPct     Float   @default(53)
  allocVacationPct   Float   @default(20)
  allocBufferPct     Float   @default(7)
  updatedAt          DateTime @updatedAt
}

model FinancialRule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  detail    String
  active    Boolean  @default(true)
  order     Int      @default(0)

  @@index([userId])
}

model CalendarEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  type      String   // salary, rent, bill, subscription, savings, investment, vacation
  date      DateTime
  amount    Float?
  notes     String?
  reminder  Boolean  @default(false)

  @@index([userId])
}
