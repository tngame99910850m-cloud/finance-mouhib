# Postgres connection string (Neon, Supabase, Vercel Postgres, etc.)
# Vercel Postgres / Neon typically also give you a separate direct/unpooled
# URL for migrations — see README for DIRECT_URL guidance if you hit
# connection issues running `prisma migrate` through a pooled connection.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# NextAuth v5 reads AUTH_SECRET; NEXTAUTH_SECRET is kept for compatibility.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Set to your real deployed origin in production (e.g. https://your-app.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# Required so NextAuth trusts the request Host header on Vercel/behind a proxy
AUTH_TRUST_HOST=true
